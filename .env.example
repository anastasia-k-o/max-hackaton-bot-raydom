# Единые настройки всей системы: бот, Core Backend, мини-приложение.
#
#   make env      создаёт .env из этого файла и подставляет случайные ключи
#
# .env в git не попадает. Настоящий токен и ключи держите только там.
# Подробные пояснения к переменным бота: bot/.env.example.

# --- Порты на вашей машине -----------------------------------------------------

FRONTEND_PORT=4173
CORE_PORT=8090
BOT_PORT=8080

# --- Ключи между сервисами -------------------------------------------------------
#
# Каждый ключ задаётся один раз, оба сервиса читают одно и то же значение.
#   INTERNAL_API_KEY  Core Backend → бот  (уведомления)
#   CORE_API_KEY      бот → Core Backend  (нажатия кнопок)

INTERNAL_API_KEY=change-me
CORE_API_KEY=change-me-too

# --- Бот и MAX -----------------------------------------------------------------

# mock — без MAX и без токена, сообщения видны в GET :8080/dev/max/messages;
# real — настоящий MAX, нужен MAX_BOT_TOKEN.
MAX_MODE=mock
MAX_BOT_TOKEN=
# polling работает без публичного адреса. webhook — только с HTTPS-адресом бота.
MAX_UPDATES_MODE=polling
MAX_WEBHOOK_SECRET=
# Сертификат УЦ Минцифры (bash bot/scripts/max-install-ca.sh).
# Для запуска без Docker — абсолютный путь к файлу. В Docker достаточно, чтобы
# переменная была непустой: файл берётся из bot/certs/russian_trusted_root_ca.pem.
MAX_CA_FILE=
# link — кнопка «Открыть афишу» ссылкой; open_app — внутри MAX (нужна
# привязка мини-приложения к боту у организаторов).
MAX_MINIAPP_BUTTON=link
APP_ENV=dev
LOG_LEVEL=info

# Ваш max_user_id — для bot/scripts/demo.sh и backend/scripts/scenario.sh.
DEMO_MAX_USER_ID=

# --- Мини-приложение -----------------------------------------------------------

# Публичный HTTPS-адрес мини-приложения с /app на конце: адрес туннеля к
# FRONTEND_PORT или домен сервера. Из него строятся ссылки «Открыть афишу».
# Пусто — кнопки-ссылки в сообщениях не будет.
MINI_APP_URL=
# Ссылка на диалог с ботом, для баннера «Откройте бота» в мини-приложении.
MAX_BOT_URL=https://max.ru/t645_hakaton_max_bot
# false — мини-приложение работает с Core Backend; true — на встроенных моках.
VITE_USE_MOCKS=false
# true — мини-приложение, открытое вне MAX (в браузере по ссылке из бота),
# входит под вашим аккаунтом DEMO_MAX_USER_ID. Работает только с DEV_MODE=true.
# Нужно, пока мини-приложение не привязано к боту в MAX. Любой, кто знает
# адрес туннеля, войдёт под этим аккаунтом — для показа жюри выключайте.
VITE_DEV_LOGIN=false

# --- Core Backend ----------------------------------------------------------------

# /dev/*: вход без MAX, перевод часов, демо-участники. Только для проверки —
# с ним кто угодно действует от имени кого угодно. На публичном сервере false.
DEV_MODE=true
# http — уведомления уходят боту; log — только в лог Core Backend.
NOTIFY_MODE=http
# real — расписание из ТЗ (24 ч, 6 ч, 3 ч, 1 ч); fast — то же в минутах.
TIMING_PRESET=real
# Пустая база наполняется мероприятиями из моков мини-приложения.
SEED_DEMO=true
# initData старше этого срока не принимается (вход в мини-приложение).
INITDATA_MAX_AGE=24h

# Для запуска без Docker (make run-core / make run-bot): где искать соседей.
# В Docker эти адреса задаёт docker-compose.yml.
BOT_BASE_URL=http://localhost:8080
CORE_BASE_URL=http://localhost:8090
CORE_MODE=http
