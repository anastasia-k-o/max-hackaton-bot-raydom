# =============================================================================
# MAX Bot — пример конфигурации
#
# Скопируйте в .env и правьте под себя:
#     cp .env.example .env
#
# Значения ниже достаточны для полного локального прогона: mock MAX + stub
# Core, без токена, без интернета, без базы данных.
#
# .env добавлен в .gitignore. Никогда не коммитьте настоящие секреты.
# =============================================================================

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------

# dev | prod
# dev включает инспекционные эндпоинты /dev/*. В prod они не регистрируются
# вовсе и отдают 404.
APP_ENV=dev

# Порт HTTP-сервера.
# ВАЖНО для real mode: MAX доставляет webhook только на порты
# 80, 8080, 443, 8443 или 16384-32383. Сам бот работает на любом порту —
# ограничение относится к публичному адресу, который вы регистрируете в
# POST /subscriptions.
HTTP_PORT=8080

# debug | info | warn | error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# MAX
# -----------------------------------------------------------------------------

# mock | real
#   mock — сообщения пишутся в память, наружу ничего не уходит, токен не нужен
#   real — реальный MAX Bot API (platform-api2.max.ru)
MAX_MODE=mock

# Токен бота от @MasterBot в MAX. Нужен только при MAX_MODE=real.
# При MAX_MODE=real с пустым токеном приложение откажется стартовать с
# понятной диагностикой — см. docs/MAX_SETUP.md.
MAX_BOT_TOKEN=

# webhook | polling
# Откуда бот берёт события. Режимы ВЗАИМОИСКЛЮЧАЮЩИЕ: в схеме MAX прямо
# сказано, что GET /updates предназначен для бота, НЕ подписанного на webhook.
#
#   webhook — MAX стучится к нам. Нужен публичный HTTPS-адрес: либо сервер,
#             либо туннель (ngrok, cloudflared) на время разработки.
#
#   polling — бот сам забирает события, открывая исходящее соединение.
#             Публичный адрес НЕ нужен, поэтому работает с ноутбука за NAT
#             без туннеля и без стороннего сервиса.
#
# Если MAX_MODE=real и MAX_UPDATES_MODE=polling, маршрут POST /webhooks/max
# не поднимается вовсе: проверять подпись в этом режиме нечем, а открытый
# эндпойнт позволил бы кому угодно подтвердить чужую регистрацию.
MAX_UPDATES_MODE=webhook

# Секрет webhook: то же значение, что вы передаёте в POST /subscriptions.
# MAX присылает его в заголовке X-Max-Bot-Api-Secret.
# Это НЕ то же самое, что INTERNAL_API_KEY ниже.
# Обязателен только при MAX_MODE=real и MAX_UPDATES_MODE=webhook.
MAX_WEBHOOK_SECRET=

# Параметры опроса. Действуют при MAX_UPDATES_MODE=polling.
# Границы заданы схемой MAX; значение за границей отвергается при старте, а
# не исправляется молча.

# Сколько секунд MAX удерживает соединение, ожидая событий (0..90).
# Это и есть «long» в long polling: при отсутствии событий ответ приходит не
# сразу, а по истечении этого времени. Больше значение — меньше холостых
# запросов.
MAX_POLL_TIMEOUT=30

# Максимум событий в одном ответе (1..1000).
MAX_POLL_LIMIT=100

# Необязательно: переопределение хоста MAX API. Пусто = platform-api2.max.ru.
# Нужно только для тестов против подменного сервера.
MAX_BASE_URL=

# Дополнительный корневой сертификат для соединения с MAX (файл PEM).
# Нужен, если MAX отдаёт сертификат УЦ, которого нет в системном наборе —
# так сейчас обстоит дело с УЦ Минцифры России. Симптом: бот не стартует с
# сообщением «TLS-соединение с MAX не устанавливается».
#
# Диагностика:  bash scripts/max-tls-check.sh
#
# Сертификат ДОБАВЛЯЕТСЯ к системному набору и действует ТОЛЬКО на соединение
# с MAX. В отличие от переменной SSL_CERT_FILE, которая влияет на весь
# процесс целиком, включая вызовы Core Backend.
MAX_CA_FILE=

# Таймаут одного вызова MAX API.
MAX_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Core Backend
# -----------------------------------------------------------------------------

# stub | http
#   stub — действия пишутся в память, всегда успех; смотреть в /dev/core/actions
#   http — реальные HTTP-вызовы к Core Backend
CORE_MODE=stub

# Корень API Core Backend. Обязателен при CORE_MODE=http.
# Например: https://api.afisha.example.ru/v1
CORE_BASE_URL=

# Ключ, которым бот аутентифицируется в Core Backend (заголовок X-Api-Key).
CORE_API_KEY=

# Таймаут одного вызова Core Backend.
CORE_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Защита собственного API бота
# -----------------------------------------------------------------------------

# Общий секрет между Core Backend и ботом.
# Передаётся в заголовке X-Internal-Api-Key при вызове POST /api/v1/notifications.
# Это НЕ MAX_WEBHOOK_SECRET: разные стороны, разные механизмы.
# В APP_ENV=prod значение "change-me" будет отвергнуто при старте.
INTERNAL_API_KEY=change-me

# -----------------------------------------------------------------------------
# Мини-приложение
# -----------------------------------------------------------------------------

# Ссылка по умолчанию на мини-приложение. Используется в приветствии и там,
# где в уведомлении не передан event.mini_app_url.
# Если пусто — кнопка-ссылка просто не добавляется, сообщение не ломается.
#
# Мини-приложение открывает карточку по пути /app/{event_id}, поэтому адрес
# указывается с /app на конце: https://<хост>/app
MINI_APP_URL=https://afisha.example.ru/app

# link | open_app
# Как кнопка «Открыть афишу» открывает мини-приложение.
#
#   link     — обычная ссылка, откроется в браузере. Работает без настройки,
#              но мини-приложение не получит initData и не узнает пользователя.
#              В режиме моков фронта это не мешает: там демо-вход.
#
#   open_app — откроется внутри MAX, с initData; id мероприятия уйдёт
#              мини-приложению как start_param, и оно откроет нужную карточку.
#              Требует, чтобы мини-приложение было привязано к этому боту в
#              MAX — это делает владелец токена. Пока привязки нет, MAX может
#              отвергать все сообщения с такой кнопкой, поэтому по умолчанию
#              выключено.
MAX_MINIAPP_BUTTON=link

# -----------------------------------------------------------------------------
# Прочее
# -----------------------------------------------------------------------------

# Сколько помнить обработанные request_id и callback_id.
# Реализация — in-memory: не переживает рестарт и не разделяется между
# репликами. Ограничение осознанное, см. docs/ARCHITECTURE.md.
IDEMPOTENCY_TTL=30m

# Сколько ждать завершения активных запросов при остановке.
SHUTDOWN_TIMEOUT=10s
